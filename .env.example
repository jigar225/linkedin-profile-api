# ── auth (pick ONE) ──────────────────────────────────────────────────
# A) full session jar — PRIMARY. Local: run scripts/linkedin_login.py
#    (writes ../linkedin_session.json). Cloud: paste the jar's contents
#    into LINKEDIN_SESSION_JSON.
# LINKEDIN_SESSION_FILE=../linkedin_session.json
# LINKEDIN_SESSION_JSON=

# B) stripped jar — fallback when no session jar exists.
LI_AT=
JSESSIONID=

# ── cloud deploy ─────────────────────────────────────────────────────
# Static/sticky RESIDENTIAL proxy in the birth machine's country.
# Required on datacenter egress — home-born jar + cloud IP kills sessions.
# LINKEDIN_PROXY=http://user:pass@host:port

# ── server ───────────────────────────────────────────────────────────
PORT=8080
# LINKEDIN_PACING=human   # "fast" = local dev only, risks the account
