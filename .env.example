# Auth: the full browser-born jar is PRIMARY — locally it lands at
# ../linkedin_session.json via scripts/linkedin_login.py; on cloud deploys
# paste the same file's contents into LINKEDIN_SESSION_JSON (Railway has no
# filesystem for secrets). These two env cookies are the stripped-jar
# FALLBACK (used only when no jar exists).
LI_AT=
JSESSIONID=
# LINKEDIN_SESSION_FILE=../linkedin_session.json
# LINKEDIN_SESSION_JSON=

# Cloud deploys: route through a RESIDENTIAL proxy matched to the birth
# machine's geography — a jar born on a home IP but used from a datacenter
# egress is the community-proven #1 session-kill pattern.
# LINKEDIN_PROXY=http://user:pass@residential-proxy.example:8080

# ── server ───────────────────────────────────────────────────────────
PORT=8080

# Request rhythm toward LinkedIn. Unset = "human": calls go out with
# jittered pauses, mimicking the real web app. Set to "fast" for local
# development only — the all-at-once burst pattern is an automation
# fingerprint that risks the account.
# LINKEDIN_PACING=human

